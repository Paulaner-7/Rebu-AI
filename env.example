# Copia in .env.local e compila. MAI committare il file locale (già in .gitignore).
# Supabase: lascia vuoto per uso locale mock (Fase 1). Obbligatorio dal deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Abbonamento OpenCode Go (solo server, Fase 5). Lascia vuoto per ora.
OPENCODE_API_KEY=
# Codice accesso app privata. Cambia subito nel file locale.
REBU_ACCESS_CODE=rebu-dev-001
# Segreto firma sessione. Genera uno casuale in prod.
REBU_SESSION_SECRET=
